---
import Layout from "../layouts/Layout.astro";
import contactHeroImg from "../assets/contact/contact-dos-bros-car-detailing-morris-mn.webp";
import ContactHeroSection from "../components/contact/ContactHeroSection.jsx";
import ContactReachAndFormSection from "../components/contact/ContactReachAndFormSection.jsx";
import WhatHappensNextSection from "../components/contact/WhatHappensNextSection.jsx";
import SpeedUpQuoteSection from "../components/contact/SpeedUpQuoteSection.jsx";
import ServiceAreaSection from "../components/contact/ServiceAreaSection.jsx";
import ContactFaqSection from "../components/contact/ContactFaqSection.jsx";
---

<Layout
  title="Contact Dos Bros Detailing | Morris, MN"
  description="Get in touch with Dos Bros Detailing for a quote or booking. Tell us what you drive and where you are, and we’ll give you a straightforward price."
  showNav={true}
  showFooter={true}
  preloadImage={contactHeroImg.src}
>
  <ContactHeroSection />
  <ContactReachAndFormSection client:load />
  <WhatHappensNextSection client:visible />
  <SpeedUpQuoteSection client:visible />
  <ServiceAreaSection client:visible />
  <ContactFaqSection client:visible />
</Layout>
