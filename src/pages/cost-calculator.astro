---
import Layout from '../layouts/Layout.astro';
import calculatorHeroImg from '../assets/prices/car-detailing-cost-calculator-morris-mn.webp';
import CostCalculatorHeroSection from '../components/prices/CostCalculatorHeroSection.jsx';
import CostCalculatorSection from '../components/prices/CostCalculatorSection.jsx';
import HowQuoteIsBuiltSection from '../components/prices/HowQuoteIsBuiltSection.jsx';
import WhatCanMoveTheNumberSection from '../components/prices/WhatCanMoveTheNumberSection.jsx';
import IsItWorthItSection from '../components/prices/IsItWorthItSection.jsx';
import ServiceTimeSection from '../components/prices/ServiceTimeSection.jsx';
import PricingFaqSection from '../components/prices/PricingFaqSection.jsx';
import PricingCtaSection from '../components/prices/PricingCtaSection.jsx';
import { getCostCalculatorSchema } from '../data/costCalculatorSchema.js';

const siteUrl = 'https://dosbrosdetailingmn.com';
const calculatorHeroImgUrl = new URL(calculatorHeroImg.src, siteUrl).toString();
const costCalculatorSchema = getCostCalculatorSchema(calculatorHeroImgUrl);
---

<Layout 
  title="Car Detailing Cost & Prices in Morris, MN | Dos Bros Detailing"
  description="See car detailing prices in Morris, MN and get a starting estimate in about 30 seconds. Compare interior, exterior, and full detail packages."
  showNav={true}
  showFooter={true}
  preloadImage={calculatorHeroImg.src}
  schema={costCalculatorSchema}
>
  <CostCalculatorHeroSection />
  <CostCalculatorSection client:load />
  <HowQuoteIsBuiltSection client:visible />
  <!-- <WhatCanMoveTheNumberSection client:visible /> -->
  <IsItWorthItSection client:visible />
  <!-- <ServiceTimeSection client:visible /> -->
  <PricingFaqSection client:visible />
  <PricingCtaSection client:visible />
</Layout>
