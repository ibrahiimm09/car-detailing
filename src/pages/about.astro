---
import Layout from "../layouts/Layout.astro";
import AboutHeroSection from "../components/about/AboutHeroSection.jsx";
import WhoWeAreSection from "../components/about/WhoWeAreSection.jsx";
import WhyWeStartedSection from "../components/about/WhyWeStartedSection.jsx";
import WhyMobileSection from "../components/about/WhyMobileSection.jsx";
import HowWeDoThingsSection from "../components/about/HowWeDoThingsSection.jsx";
import AboutFaqSection from "../components/about/AboutFaqSection.jsx";
import AboutCtaBanner from "../components/about/AboutCtaBanner.jsx";
import ProjectGallerySection from "../components/home/ProjectGallerySection.jsx";
---

<Layout
  title="About Dos Bros Detailing | Mobile Detailing in Morris, MN"
  description="Meet the brothers behind Dos Bros Detailing, a local mobile detailing business serving Morris, MN and surrounding communities. Learn our story."
  showNav={true}
  showFooter={true}
>
  <AboutHeroSection client:load />
  <WhoWeAreSection client:visible />
  <WhyWeStartedSection client:visible />
  <WhyMobileSection client:visible />
	<ProjectGallerySection client:visible />

  <HowWeDoThingsSection client:visible />
  <AboutFaqSection client:visible />
  <AboutCtaBanner client:visible />
</Layout>
