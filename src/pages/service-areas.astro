---
import Layout from '../layouts/Layout.astro';
import serviceAreaHeroImg from '../assets/servicearea/morris-mn-car-detailing-service-areas.webp';
import ServiceAreaHeroSection from '../components/service-areas/ServiceAreaHeroSection.jsx';
import HowTravelWorksSection from '../components/service-areas/HowTravelWorksSection.jsx';
import ServiceAreaSection from '../components/service-areas/ServiceAreaSection.jsx';
import WhatWeBringSection from '../components/service-areas/WhatWeBringSection.jsx';
import ServiceAreaFaqSection from '../components/service-areas/ServiceAreaFaqSection.jsx';
import ServiceAreaCtaSection from '../components/service-areas/ServiceAreaCtaSection.jsx';
import { getServiceAreasSchema } from '../data/serviceAreasSchema.js';

const siteUrl = 'https://dosbrosdetailingmn.com';
const serviceAreaHeroImgUrl = new URL(serviceAreaHeroImg.src, siteUrl).toString();
const serviceAreasSchema = getServiceAreasSchema(serviceAreaHeroImgUrl);
---

<Layout 
  title="Areas We Servce | Morris, MN & Surrounding Towns"
  description="See where Dos Bros Detailing travels across west-central Minnesota. We come to your driveway, workplace, or farm site in Morris and surrounding towns."
  showNav={true}
  showFooter={true}
  preloadImage={serviceAreaHeroImg.src}
  schema={serviceAreasSchema}
>
  <ServiceAreaHeroSection />
  <!-- <HowTravelWorksSection client:visible /> -->
  <ServiceAreaSection client:visible />
  <WhatWeBringSection client:visible />
  <ServiceAreaFaqSection client:visible />
  <ServiceAreaCtaSection client:visible />
</Layout>
