---

<div
  id="scroll-to-top-btn"
  class="fixed bottom-6 right-6 z-50 transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
>
  <button
    type="button"
    aria-label="Scroll back to top"
    id="scroll-to-top-action"
    class="w-11 h-11 rounded-full bg-neutral-950/90 hover:bg-neutral-900 border border-neutral-800 hover:border-red-500/50 shadow-xl backdrop-blur-md flex items-center justify-center cursor-pointer transition-all duration-200 hover:scale-105 active:scale-95 group focus:outline-none"
  >
    <svg
      class="w-4 h-4 text-neutral-400 group-hover:text-red-500 group-hover:-translate-y-0.5 transition-all duration-200"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2.5"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
  </button>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById("scroll-to-top-btn");
    var action = document.getElementById("scroll-to-top-action");
    if (!btn) return;

    var ticking = false;
    var isVisible = false;

    function update() {
      var top = window.scrollY || window.pageYOffset || 0;
      var shouldShow = top > 150;

      if (shouldShow !== isVisible) {
        isVisible = shouldShow;
        if (isVisible) {
          btn.classList.remove(
            "opacity-0",
            "translate-y-4",
            "pointer-events-none"
          );
          btn.classList.add(
            "opacity-100",
            "translate-y-0",
            "pointer-events-auto"
          );
        } else {
          btn.classList.add("opacity-0", "translate-y-4", "pointer-events-none");
          btn.classList.remove(
            "opacity-100",
            "translate-y-0",
            "pointer-events-auto"
          );
        }
      }
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });

    if (document.readyState === "complete") {
      window.requestAnimationFrame(update);
    } else {
      window.addEventListener(
        "load",
        function () {
          window.requestAnimationFrame(update);
        },
        { once: true }
      );
    }

    if (action) {
      action.addEventListener("click", function () {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
  })();
</script>
